{
  "name": "@openclaw/xmpp",
  "version": "4.1.1",
  "description": "Minimal text-only XMPP channel plugin for OpenClaw",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "test": "vitest",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"index.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"index.ts\"",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Programmatore-Web/openclaw-xmpp-channel.git"
  },
  "bugs": {
    "url": "https://github.com/Programmatore-Web/openclaw-xmpp-channel/issues"
  },
  "homepage": "https://github.com/Programmatore-Web/openclaw-xmpp-channel#readme",
  "author": "OpenClaw Contributors",
  "license": "MIT",
  "engines": {
    "node": ">=22.22.3 <23 || >=24.15.0 <25 || >=25.9.0"
  },
  "dependencies": {
    "@xmpp/client": "^0.14.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^9.39.2",
    "prettier": "^3.8.1",
    "rimraf": "^5.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "peerDependencies": {
    "openclaw": "^2026.8.2"
  },
  "overrides": {
    "zod": "4.3.6"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "channel": {
      "id": "xmpp",
      "label": "XMPP",
      "selectionLabel": "XMPP (Jabber/Prosody/ejabberd)",
      "docsPath": "/channels/xmpp",
      "blurb": "Connect to XMPP servers including Prosody and ejabberd.",
      "aliases": [
        "jabber",
        "prosody",
        "ejabberd"
      ]
    }
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "xmpp",
    "jabber",
    "prosody",
    "ejabberd",
    "channel",
    "chat",
    "messaging",
    "im"
  ]
}
