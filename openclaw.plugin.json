      "label": "XMPP",
      "description": "Minimal XMPP/Jabber text channel with fail-closed DM/group defaults and multi-account support.",
      "uiHints": {
        "": {
          "label": "XMPP",
          "help": "XMPP/Jabber channel provider for Prosody, ejabberd, and other XMPP servers. Configure a single account at the root, or multiple under 'accounts'."
        },
        "jid": {
          "label": "Bot JID",
          "help": "Bot JID, e.g. bot@example.com (single-account setups)."
        },
        "password": {
          "label": "Password",
          "help": "XMPP account password (sensitive)."
        },
        "server": {
          "label": "Server",
          "help": "Physical TCP connection host. Defaults to the JID domain and does not change the logical XMPP domain used for authentication."
        },
        "port": {
          "label": "Port",
          "help": "XMPP server port (default 5222)."
        },
        "dmPolicy": {
          "label": "DM Policy",
          "help": "Direct message access: disabled (owners only), open (allow all), pairing (require approval), allowlist (only allowFrom/dmAllowlist)."
        },
        "groupPolicy": {
          "label": "Group Policy",
          "help": "Group message access: open or allowlist."
        },
        "allowFrom": {
          "label": "Owner JIDs",
          "help": "Bot owner JIDs \u2014 always have direct chat access and cannot be removed by guests."
        },
        "accounts": {
          "label": "Accounts",
          "help": "Multi-account map keyed by account id; each entry mirrors the single-account fields."
        }
